{
  "//": "复制为 config.json 后修改。apiKey 支持 ${ENV_NAME} 形式引用环境变量。",

  "baseUrl": "https://api.deepseek.com/v1",
  "apiKey": "${DEEPSEEK_API_KEY}",
  "model": "deepseek-chat",

  "//其他常见配置": {
    "OpenAI": { "baseUrl": "https://api.openai.com/v1", "model": "gpt-4o-mini" },
    "通义千问": { "baseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1", "model": "qwen-plus" },
    "Kimi": { "baseUrl": "https://api.moonshot.cn/v1", "model": "moonshot-v1-8k" },
    "智谱": { "baseUrl": "https://open.bigmodel.cn/api/paas/v4", "model": "glm-4-plus" },
    "本地 Ollama": { "baseUrl": "http://127.0.0.1:11434/v1", "apiKey": "ollama", "model": "qwen2.5:7b" },
    "本地 LM Studio": { "baseUrl": "http://127.0.0.1:1234/v1", "apiKey": "lm-studio", "model": "qwen2.5-7b-instruct" }
  },

  "temperature": 0.6,
  "stream": true,

  "workspace": ".",
  "allowOutsideWorkspace": false,
  "commandTimeoutMs": 60000,
  "outputLimit": 20000,

  "autoApprove": false,
  "maxSteps": 12,

  "enabledSkills": "*",
  "enabledPlugins": "*",

  "systemPrompt": "你是 MiniAgent，一个运行在用户本机上的通用智能体。你可以和用户自然对话，也可以调用工具读写文件、执行命令、访问网页。回答使用用户所用的语言，简洁、准确、诚实；不确定时先查证而不是猜测。"
}
